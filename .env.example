# Copy to .env.local and fill in. Never commit real values.

# Supabase - `supabase status` prints local values; cloud values are under
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the app, used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe, test mode. `stripe listen` prints the local webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Accounts created by `npm run db:seed-users`. These are the test credentials
# shared with evaluators, so use throwaway values.
SEED_ADMIN_EMAIL=admin@digitalheroes.test
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=golfer@digitalheroes.test
SEED_USER_PASSWORD=

# Password for the demo members created by `npm run db:seed-demo`.
DEMO_PASSWORD=
